# Database
POSTGRES_USER=atena
POSTGRES_PASSWORD=atena
POSTGRES_DB=atena_study
DATABASE_URL=postgresql+psycopg://atena:atena@db:5432/atena_study

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3100,http://localhost:3000,http://web:3000

# Web (host ports: API 8100, Web 3100 — avoid common conflicts)
NEXT_PUBLIC_API_URL=http://localhost:8100

# Qdrant (reserved for future RAG)
QDRANT_URL=http://qdrant:6333

# Geração de materiais em background (opcional)
# WEB_SEARCH_INTERVAL_SECONDS=1.5
# ENRICH_CONCURRENCY=5

# DeepSeek is configured in the app UI (Configurações),
# persisted in PostgreSQL app_settings — not required in .env.

